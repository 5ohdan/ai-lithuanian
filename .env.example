# Since the ".env" files are gitignored, use this file as a template when
# cloning the repo. It is committed, so never put real secrets here.
#
# Environment model:
#   1. SERVER-ONLY secrets (read via getCloudflareContext, src/lib/env.ts):
#        - local dev  -> .dev.vars (gitignored)
#        - deployed   -> wrangler secret put <NAME>
#   2. BUILD-TIME public vars (inlined into the client bundle):
#        -> .env.development (next dev) / .env.production (deploy build)
#      If a var appears here, it does NOT need to be in .dev.vars, and
#      vice versa — that duplication is what causes env drift.
#
# When adding a server variable, update src/lib/env.ts accordingly; when
# adding a public one, update src/lib/public-env.ts.

# --- 1. Server-only ---------------------------------------------------
BETTER_AUTH_SECRET=
GOOGLE_GENERATIVE_AI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CI-only: D1 migrations / deploy credentials (GitHub Actions secrets)
CLOUDFLARE_ACCOUNT_ID=
DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# --- 2. Build-time public (.env.development / .env.production) --------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
