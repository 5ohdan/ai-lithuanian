{
  "$schema": "node_modules/wrangler/config-schema.json",
  // vinext's worker entry: vinext provides the worker; the plugin builds it.
  "main": "vinext/server/fetch-handler",
  "name": "ai-lithuanian",
  "compatibility_date": "2025-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // produced by `vite build` (build:vinext)
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ],
  },
  "kv_namespaces": [
    {
      "binding": "SESSION_STORAGE",
      "id": "3988f759ed464c7d9e39a4e8a5d10cd5",
    },
  ],
  // Cloudflare rate limiting binding: 5 words-generation requests per user per minute.
  // Only supported periods are 10s and 60s.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "d1_databases": [
    {
      "database_name": "ai-lithuanian",
      "binding": "DB",
      "database_id": "35b33b5a-16a8-4f52-85e1-c28e2701eaa3",
      "migrations_dir": "src/db/migrations",
    },
  ],

  "observability": {
    "enabled": true,
  },
  "placement": {
    "mode": "smart",
  },
}
