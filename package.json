{
  "name": "ai-lithuanian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "preview": "vite build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "vite build && wrangler deploy --config dist/server/wrangler.json",
    "check": "oxlint --type-aware && tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fmt:fix": "oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:next": "next dev --turbopack",
    "build:next": "next build",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:test": "node --test scripts/test-db-migrations.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/react": "^3.0.170",
    "@hookform/resolvers": "^5.2.2",
    "@libsql/client": "^0.17.3",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vinext/cloudflare": "^1.3.0",
    "ai": "^6.0.168",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-beta.15-859cf75",
    "lucide-react": "^0.562.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.9",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.442.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-server-dom-webpack": "^19.3.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "vinext": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-beta.15-859cf75",
    "globals": "^17.13.0",
    "oxc-transform-react": "^0.152.0",
    "oxfmt": "^0.34.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.0-beta",
